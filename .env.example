# Copy to .env and fill in your keys (never commit .env)

# --- Ollama cloud ---
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=kimi-k2.6

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local Ollama (--local or leave OLLAMA_API_KEY empty):
# OLLAMA_LOCAL_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b
# Run: python run.py --agent ollama --model llama3.2:1b --local
